# ─── Database ─────────────────────────────────────────────────────────────────
# Neon or local PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/crea8or_db

# ─── Auth ─────────────────────────────────────────────────────────────────────
BETTER_AUTH_SECRET=your_better_auth_secret_here
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ─── URLs ──────────────────────────────────────────────────────────────────────
WEB_URL=http://localhost:3000
API_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# ─── Payments (African First) ─────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=your_paystack_secret_key_here
PAYSTACK_PUBLIC_KEY=your_paystack_public_key_here
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=your_paystack_public_key_here

# ─── Email ────────────────────────────────────────────────────────────────────
RESEND_API_KEY=your_resend_api_key_here

# ─── Storage (Phase 2) ────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=crea8or-files

# ─── AI (Phase 4) ─────────────────────────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key_here
